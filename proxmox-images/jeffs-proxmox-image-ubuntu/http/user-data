#cloud-config
# =============================================================================
# user-data - jeffs-proxmox-image-ubuntu
# =============================================================================
# This file is served by Packer's temporary HTTP server during the build.
# It's the info used during the first time you boot up ubuntu
# =============================================================================

autoinstall:
  version: 1

  # ----------------------------------------
  # Locale / Keyboard

  locale: en_US.UTF-8
  keyboard:
    layout: us

  # ----------------------------------------
  # Network - Static IP used during Packer build only
  # This IP is temporary - wiped when template is cloned

  network:
    network:
      version: 2
      ethernets:
        ens18:
          dhcp4: false
          addresses:
            - 192.168.20.250/24
          gateway4: 192.168.20.1
          nameservers:
            addresses: [8.8.8.8]

  # ----------------------------------------
  # Disk

  storage:
    layout:
      name: direct

  # ----------------------------------------
  # Packer user
  # Password creates a valid unlocked user account
  # SSH login uses key auth not this password

  identity:
    hostname: ubuntu-template
    username: packer
    password: "$6$saltsalt$eWwzB8NsnzXoqwWcOO6uEVzQ5ZohAdKgL6rIPMq5OgmNbHSyBHrDQkOZzqKKHa/F9Mp7rYyAiHB.reGkw.iqL1"

  # ----------------------------------------
  # SSH - key auth only, no password auth

  ssh:
    install-server: true
    allow-pw: false
    authorized-keys:
      - ssh-rsa  Keys for Github (TK3-PC (WSL2))

  # ----------------------------------------
  # Packages

  packages:
    - qemu-guest-agent

  # ----------------------------------------
  # Late commands

  late-commands:
    - echo 'packer ALL=(ALL) NOPASSWD:ALL' > /target/etc/sudoers.d/packer
    - chmod 440 /target/etc/sudoers.d/packer

  # ----------------------------------------
  # Force reboot after install completes

  shutdown: reboot
