#cloud-config
# =============================================================================
# user-data - jeffs-virtualbox-image-ubuntu
# =============================================================================
# This file is served by Packer's temporary HTTP server during the build.
# It's the info used during the first time you boot up ubuntu
# =============================================================================

autoinstall:
  version: 1

  # add this near the top
  interactive-sections: []

  # ----------------------------------------
  # Locale / Keyboard

  locale: en_US.UTF-8
  keyboard:
    layout: us

  # ----------------------------------------
  # Network - DHCP via NAT
  # VirtualBox handles networking automatically via NAT
  # No static IP needed unlike Proxmox

  network:
    network:
      version: 2
      ethernets:
        enp0s3:
          dhcp4: true

  # ----------------------------------------
  # Disk

  storage:
    layout:
      name: direct

  # ----------------------------------------
  # Packer user

  identity:
    hostname: ubuntu-vb-template
    username: packer
    password: "$6$6TBZaDE+RPk9zNpY$dl.kZbiqivLCk33ZlCgRdolJTFBY0QU7TvHzZIka2HDzvOerZqgREPLDihYNN7Pnw2iM18bT7Zi233dUhrmpz/"

  # ----------------------------------------
  # SSH - key auth only, no password auth

  ssh:
    install-server: true
    allow-pw: false
    authorized-keys:
      - ssh-rsa  virtualbox universal keys

  # ----------------------------------------
  # Late commands

  late-commands:
    - echo 'packer ALL=(ALL) NOPASSWD:ALL' > /target/etc/sudoers.d/packer
    - chmod 440 /target/etc/sudoers.d/packer

  # ----------------------------------------
  # Force reboot after install completes

  shutdown: reboot
